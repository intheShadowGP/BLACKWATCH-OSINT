{
  "name": "blackwatch-osint",
  "private": true,
  "version": "1.0.0",
  "description": "BLACKWATCH OSINT — frontend-only open-source intelligence investigation platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "check:secrets": "node scripts/check-secrets.mjs",
    "ci": "npm run typecheck && npm run test && npm run check:secrets && npm run build"
  },
  "dependencies": {
    "cytoscape": "3.35.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "exifr": "7.1.3",
    "jspdf": "4.2.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
